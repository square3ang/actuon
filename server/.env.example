# Copy to .env. Only needed for backups; leave it out to run without them.
COMPOSE_PROFILES=backup
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com with region auto.
# AWS: https://s3.<region>.amazonaws.com with that region.
S3_ENDPOINT=
S3_REGION=auto
# The bucket must exist already. Keep it private: backups hold password and token hashes.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# IR_PORT=8730
