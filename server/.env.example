# Copy to .env for server/deploy.sh: rclone settings for the backup remote.
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Other
# R2: https://<account id>.r2.cloudflarestorage.com, region auto. AWS: https://s3.<region>.amazonaws.com, that region.
RCLONE_CONFIG_BACKUP_ENDPOINT=
RCLONE_CONFIG_BACKUP_REGION=auto
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
# An R2 token limited to one bucket may not list buckets.
RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true
# The bucket must exist already. Keep it private: backups hold password and token hashes.
S3_BUCKET=
